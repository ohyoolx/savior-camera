{
  "expo": {
    "name": "savior-camera",
    "slug": "savior-camera",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "saviorcamera",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
          "ios": {
        "supportsTablet": true,
        "deploymentTarget": "15.5",
        "infoPlist": {
          "NSCameraUsageDescription": "允许应用访问您的相机以进行人脸识别和拍照。"
        },
        "bundleIdentifier": "com.anonymous.saviorcamera"
      },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ],
      "package": "com.anonymous.saviorcamera"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "允许应用访问您的相机以拍照。"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "允许应用保存照片到您的相册。",
          "savePhotosPermission": "允许应用保存照片到您的相册。",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "允许应用访问您的相机以进行人脸识别和拍照。",
          "enableMicrophonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
